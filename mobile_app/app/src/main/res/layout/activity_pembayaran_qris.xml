<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream_bg">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_qris"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/brand_brown_dark"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Pembayaran QRIS"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="76dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Card Utama Barcode QRIS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header QRIS & GPN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="QRIS"
                            android:textColor="@color/brand_brown_dark"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_gray"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="GPN"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_qris_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏳ 14:59"
                            android:textColor="@color/status_orange"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Nama Merchant Resmi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.05"
                        android:text="PR KERETA KENCANA"
                        android:textColor="@color/brand_brown_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="NMID: ID1020039281729 • KAB. BLITAR"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/border_light" />

                    <!-- Total Tagihan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Tagihan Pembayaran"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_qris_total_tagihan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Rp 0"
                        android:textColor="@color/price_red"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_qris_kode_trx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="No. Pesanan: -"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Frame Barcode QR Code -->
                    <FrameLayout
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_qris_frame"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iv_qris_barcode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Barcode QRIS PR Kereta Kencana"
                            android:scaleType="fitCenter" />

                        <!-- Success Overlay Indicator -->
                        <LinearLayout
                            android:id="@+id/layout_qris_success_overlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#E6F0FDF4"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/status_green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="TERVERIFIKASI"
                                android:textColor="@color/status_green"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Badge Status Pembayaran -->
                    <TextView
                        android:id="@+id/tv_qris_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_badge_belum_bayar"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="⏳ Menunggu Pembayaran Scan Barcode..."
                        android:textColor="@color/status_orange"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Simpan atau screenshot QR Code ini untuk scan melalui aplikasi mobile banking"
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Box Simulasi Scan & Bayar QRIS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_simulasi_qris"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_cream_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ Simulasi Sistem Pembayaran"
                            android:textColor="@color/brand_brown_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_lunas"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="Testing Mode"
                            android:textColor="@color/status_green"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tekan tombol di bawah untuk mensimulasikan proses scan barcode QRIS oleh mitra. Sistem pembayaran pabrik akan langsung mendeteksi pelunasan dan mengubah status pesanan menjadi Lunas secara otomatis."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Tombol Simulasi Scan & Bayar -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_simulasi_bayar_qris"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_button_primary"
                        android:text="⚡ Simulasi Scan &amp; Bayar QRIS"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progress_simulasi_qris"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:indeterminateTint="@color/brand_brown_dark"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Panduan Cara Pembayaran QRIS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Petunjuk Pembayaran QRIS"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="1. Buka aplikasi m-Banking (BCA, Mandiri, BRI, BNI) atau e-Wallet (GoPay, OVO, DANA, ShopeePay).\n2. Pilih menu Bayar atau Scan QRIS.\n3. Arahkan kamera ke barcode QR Code di atas.\n4. Pastikan nama merchant yang muncul adalah PR KERETA KENCANA.\n5. Konfirmasi pembayaran dan masukkan PIN Anda.\n6. Status pembayaran akan otomatis terverifikasi sistem dalam beberapa detik."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@color/surface_white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_action_qris"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_primary"
            android:text="Cek Status Pembayaran"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
