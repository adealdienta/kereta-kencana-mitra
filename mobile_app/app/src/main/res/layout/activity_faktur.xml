<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_brown_dark"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_faktur"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:title="Faktur Dan Nota Tagihan"
            app:titleTextColor="@color/white">

            <ImageView
                android:id="@+id/iv_toolbar_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_rounded_card_selected"
                android:contentDescription="Avatar"
                android:padding="6dp"
                android:src="@drawable/ic_account"
                app:tint="@color/brand_brown_dark" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- Lembar Faktur Fisik Digital (S29, S30) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_faktur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Kop Faktur Pabrik -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="54dp"
                            android:layout_height="40dp"
                            android:contentDescription="Logo Pabrik"
                            android:scaleType="fitCenter"
                            android:src="@drawable/logo_resmi" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.04"
                            android:text="PR. KERETA KENCANA"
                            android:textColor="@color/brand_brown_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Pabrik Sigaret Kretek • Ponggok, Blitar"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Garis Putus-putus -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@drawable/bg_dashed_line"
                        android:layerType="software" />

                    <!-- Nomor Transaksi & Badge Faktur Resmi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_faktur_no_trx"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No. TRX-2026-0930-0012"
                            android:textColor="@color/brand_brown_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_faktur_resmi"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="FAKTUR RESMI"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tanggal Transaksi -->
                    <TextView
                        android:id="@+id/tv_faktur_tanggal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="30 Sep 2026 • 09.45 WIB"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <!-- Garis Putus-putus -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@drawable/bg_dashed_line"
                        android:layerType="software" />

                    <!-- Identitas Toko Penerima -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="2dp"
                            android:contentDescription="Ikon Toko"
                            android:src="@drawable/ic_store"
                            app:tint="@color/text_secondary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_faktur_mitra"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kepada: Toko Berkah Sejahtera (Bpk. Mulyono)"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_faktur_alamat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Jl. Raya Ponggok No. 42, Blitar"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Garis Putus-putus -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@drawable/bg_dashed_line"
                        android:layerType="software" />

                    <!-- Header Tabel Item -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:text="PRODUK"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:gravity="center"
                            android:text="JUMLAH"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:gravity="end"
                            android:text="SUBTOTAL"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Container Baris Item Muatan Dinamis -->
                    <LinearLayout
                        android:id="@+id/layout_faktur_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <!-- Garis Putus-putus -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@drawable/bg_dashed_line"
                        android:layerType="software" />

                    <!-- Metode Pembayaran COD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Ikon Truk"
                            android:src="@drawable/ic_truck"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_faktur_metode_bayar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Metode bayar: COD, dibayar saat barang tiba"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Ringkasan Total Tagihan & Badge Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Tagihan"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_faktur_grand_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 162.500"
                            android:textColor="@color/price_red"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Status Pembayaran Badge (Lunas vs Belum Dibayar) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_faktur_status_stempel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_belum_bayar"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="BELUM DIBAYAR (COD)"
                            android:textColor="@color/brand_gold"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Garis Putus-putus -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@drawable/bg_dashed_line"
                        android:layerType="software" />

                    <!-- Bagian QR Code Verifikasi Kurir -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tunjukkan ke kurir saat barang tiba"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_rounded_card_selected"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/iv_faktur_qr"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="QR Code Faktur"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_faktur_inv_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:letterSpacing="0.05"
                            android:text="INV-2026-0930-0012"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_faktur_nppbkc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="NPPBKC 0821.1.2.00482"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tombol Aksi Simpan PDF (S29, S30) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_simpan_pdf"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#E4DDD3"
                android:text="Simpan PDF"
                android:textAllCaps="false"
                android:textColor="@color/brand_brown_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_download"
                app:iconGravity="textStart"
                app:iconTint="@color/brand_brown_dark" />

            <!-- Tombol Aksi Cetak Salinan Nota (S29, S30) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cetak_nota"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:text="Cetak Salinan Nota"
                android:textAllCaps="false"
                android:textColor="@color/brand_brown_dark"
                android:textSize="14sp"
                app:icon="@drawable/ic_print"
                app:iconGravity="textStart"
                app:iconTint="@color/brand_brown_dark" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
