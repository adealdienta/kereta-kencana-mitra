<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Gambar Produk -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_rounded_card"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iv_cart_item_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Gambar Produk"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_resmi" />
        </FrameLayout>

        <!-- Informasi Nama, Satuan, Subtotal -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cart_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kereta Kencana 12"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cart_item_price_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="2 slop • Rp 115.000"
                android:textColor="@color/price_red"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cart_item_content_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Isi: 10 bungkus / slop"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Counter (-) Qty (+) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_cart_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_gray">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_cart_qty"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btn_cart_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_gray">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Ikon Hapus Item (Tong Sampah) -->
        <ImageView
            android:id="@+id/btn_cart_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Hapus Item"
            android:padding="4dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_secondary" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
