<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <!-- Judul Notifikasi (Bold) -->
        <TextView
            android:id="@+id/tv_notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Judul Notifikasi"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Pesan / Deskripsi Notifikasi -->
        <TextView
            android:id="@+id/tv_notif_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="Isi pesan notifikasi dari sistem pabrik PR. Kereta Kencana."
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <!-- Tanggal & Waktu (WIB) -->
        <TextView
            android:id="@+id/tv_notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="06-11-2026 10:45 WIB"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Garis Pemisah Halus Antar Baris Notifikasi -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/border_light" />

</LinearLayout>
