<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.KeretaKencanaMitra" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_brown_dark</item>
        <item name="colorPrimaryVariant">@color/brand_brown_light</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_gold</item>
        <item name="colorSecondaryVariant">@color/brand_gold_light</item>
        <item name="colorOnSecondary">@color/brand_brown_dark</item>
        
        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/brand_brown_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/brand_cream_bg</item>
    </style>
</resources>
