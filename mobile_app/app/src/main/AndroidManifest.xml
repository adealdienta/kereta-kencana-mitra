<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin Jaringan untuk Komunikasi REST API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo_resmi"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_resmi"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeretaKencanaMitra"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- Splash Screen Launcher (S1) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity Container Tiga Tab (Beranda, Pesanan, Akun) -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Pendaftaran Mitra Baru (S7, S6) -->
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Pendaftaran Sukses Akun Aktif (S8) -->
        <activity
            android:name=".ui.auth.RegisterSuccessActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Lupa Kata Sandi 4 Langkah OTP (S12, S13, S14, S15) -->
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Detail Produk Kretek (S3) -->
        <activity
            android:name=".ui.detail.DetailProdukActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Keranjang Belanja Grosir (S4) -->
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Konfirmasi Pembelian / Pengiriman (S9) -->
        <activity
            android:name=".ui.cart.CheckoutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Pesanan Berhasil Dibuat (S10) -->
        <activity
            android:name=".ui.cart.OrderSuccessActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Pembayaran QRIS Dinamis & Simulasi Real-Time -->
        <activity
            android:name=".ui.pesanan.PembayaranQrisActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Detail Pesanan & Stepper Tracking (S25, S27, S31, S33) -->
        <activity
            android:name=".ui.pesanan.DetailPesananActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Konfirmasi Penerimaan Barang Foto Fisik (S28) -->
        <activity
            android:name=".ui.pesanan.KonfirmasiPenerimaanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Faktur & Nota Penjualan Resmi (S29, S30) -->
        <activity
            android:name=".ui.pesanan.FakturActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Ubah Data Toko Mitra (S18) -->
        <activity
            android:name=".ui.akun.DataTokoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Ubah Alamat Pengiriman Toko (S19) -->
        <activity
            android:name=".ui.akun.AlamatTokoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Layar Ubah Kata Sandi Akun (S20) -->
        <activity
            android:name=".ui.akun.UbahSandiActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- FileProvider untuk Berbagi dan Membuka Dokumen PDF Faktur -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
